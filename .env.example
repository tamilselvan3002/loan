# Personal Loan Management System - Server Environment Variables

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=personal-loan-secret-jwt-key-2026-supersecure

# Database Path (defaults to server/data/loan.db)
# DB_PATH=./server/data/loan.db

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Initial Administrator Seed Password (only used on first DB creation)
ADMIN_INITIAL_PASSWORD=Admin@12345

# SMS Provider Gateway (Options: MOCK or MSG91)
# Note: You can configure this directly inside the Admin Portal Settings page!
SMS_PROVIDER=MOCK
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MYLOAN
